{
  "name": "insightux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run build:sdk && node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.js --dev",
    "demo:sdk": "node examples/sdk-demo/server.mjs",
    "build": "vite build && npm run build:sdk",
    "build:sdk": "vite build --config vite.sdk.config.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7",
    "rrweb": "^2.1.1",
    "rrweb-player": "^2.1.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "yazl": "^3.3.1"
  }
}
